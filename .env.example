# PostgreSQL Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=lime-dev-secret-change-in-production

# Server Configuration
PORT=3000
CHAT_PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# Email (Mailtrap) — invitations de membres.
# Sans MAILTRAP_API_TOKEN, les mails sont seulement loggés (dev).
# MAILTRAP_INBOX_ID défini => mode sandbox (Email Testing, mails capturés) ;
# vide => envoi réel (Email Sending, domaine à vérifier).
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
# Expéditeur de démo Mailtrap : fonctionne sans vérifier de domaine.
MAIL_FROM=hello@demomailtrap.co
MAIL_FROM_NAME=Lime
