# PostgreSQL Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_db_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=test_secret

# Email : token vide => Mailtrap désactivé en test (les invitations sont juste
# loggées, aucun appel réseau ni dépendance externe). Chargé par Bun avant le
# dotenv de ../.env, donc non écrasé.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Server Configuration
PORT=3001
CHAT_PORT=3000
